@{
    ViewData["Title"] = "Index";
}
<link rel="stylesheet" href="~/css/indexEstilo.css">


   
    <p>aca hay listas de mucha musica</p>


    @foreach(var discosDatos in ViewBag.dicDiscos){
        
        <div>
          <p>@discosDatos.Value.nombre</p>
        <img src="~/@discosDatos.Value.imagen" alt="disco portada" width="8%" height="auto">
        
        
        <p><a  href='@Url.Action("MostrarDisco", "Home",  new {idDisco=discosDatos.Key})'>más información</a></p>
        
        </div>
      
        

    }





