<link rel="stylesheet" href="~/css/mostrarDiscoEstilo.css">

<h1>@ViewBag.disco.nombre</h1>
<p>autor @ViewBag.disco.artista</p>
<p>productor @ViewBag.disco.productor</p>
<p>genero @ViewBag.disco.generoMusical</p>
<img src="~/@ViewBag.disco.imagen" alt="disco portada" width="8%" height="auto">
<section> 
    <div>
        <ol>
        @foreach(string cancion in ViewBag.disco.temas){
            <li>@cancion</li>
        }
        </ol>   
        
    </div>
</section>

<a  href='@Url.Action("Index", "Home")'>volver</a>

